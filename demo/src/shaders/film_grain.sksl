// FilmGrain, after Shader Effects Inc. (MIT,
// github.com/shader-effects-inc/shaders, packages/core/src/shaders/FilmGrain).
// The original adds signed grain to the color below, weighted toward dark
// areas. A shader layer here can't read the frame under it, so this draws the
// same per-pixel, per-frame hash grain as a translucent light/dark speckle.
uniform float3 iResolution;
uniform float iTime;
uniform float uStrength;

float hash12(float2 p) {
    float3 p3 = fract(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

half4 main(float2 coord) {
    float t = floor(iTime * 24.0);
    float g = hash12(coord + float2(t, t * 1.6180339)) * 2.0 - 1.0;
    float a = abs(g) * uStrength;
    float3 c = g > 0.0 ? float3(1.0) : float3(0.0);
    return half4(half3(c * a), half(a));
}
