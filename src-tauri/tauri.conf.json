{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Join Approver",
  "version": "0.1.0",
  "identifier": "ai.theuploadinglab.joinapprover",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Join Approver",
        "width": 1000,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Approve Telegram join requests, and prove each one landed",
    "copyright": "\u00a9 2026 The Uploading Lab",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQTdBQjJGOTZBREM3M0QKUldROXg2MldMNnVuLzB4ZGFpWDE1ekNiUEw4eDE4RlRZYit5TE9XR1hkRTE5bHVxV2RFUWhYZnkK",
      "endpoints": [
        "https://github.com/Lulzx/join-approver/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
